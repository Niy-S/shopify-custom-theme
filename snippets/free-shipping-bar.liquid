
{% assign shipping_threshold = settings.free_shipping_threshold | times: 100 %}
{% assign amount_remaining = shipping_threshold | minus: cart.total_price %}

{% if shipping_threshold > 0 %}
  {% assign progress = cart.total_price | times: 100.0 | divided_by: shipping_threshold %}

  {% assign progress = progress | at_most: 100 %}

  <div id="FreeShippingBar" class="free-shipping-bar" role="status" aria-live="polite">
    {% if amount_remaining > 0 %}
      <p class="free-shipping-message">
        You're {{ amount_remaining | money }} away from free shipping!
      </p>
    {% else %}
      <p class="free-shipping-message">
        Congratulations! You've unlocked free shipping!
      </p>
    {% endif %}

    <div class="free-shipping-track">
      <div
        class="free-shipping-progress"
        style="width: {{ progress }}% !important; height: 10px; background-color: #21865a !important; display: block;"
        ></div>
    </div>
  </div>

  <style>
    .free-shipping-bar {
      padding: 16px;
      margin: 16px 0;
      background: #f1f5f2;
      border-radius: 8px;
      text-align: center;
    }

    .free-shipping-message {
      margin: 0 0 12px;
      font-size: 14px;
    }

    .free-shipping-track {
  display: block;
  width: 100%;
  height: 10px;
  background: #d9e2dc;
  border-radius: 20px;
  overflow: hidden;
}

.free-shipping-progress {
  display: block;
  height: 10px;
  min-width: 4px;
  background-color: #21865a;
  border-radius: 20px;
  transition: width 0.3s ease;
}
  </style>
{% endif %}
